# ==============================================================================
# Smart Parking Availability Platform - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Oracle Database Configuration (oracledb)
# Default port for Oracle is 1521. Common database/service names: FREEPDB1, XEPDB1, ORCL
ORACLE_DB_NAME=FREEPDB1
ORACLE_USER=smart_parking_user
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_HOST=localhost
ORACLE_PORT=1521

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# Recommendation Service URL (Java Spring Boot)
RECOMMENDATION_SERVICE_URL=http://localhost:8081/api/recommendation
